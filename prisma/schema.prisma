// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id              String    @id // GitHub node_id or login
  login           String    @unique
  avatarUrl       String?
  totalConfidence Int       @default(0)
  successfulPrs   Int       @default(0)
  failedPrs       Int       @default(0)
  receipts        Receipt[]
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
}

model Receipt {
  id           String   @id @default(uuid())
  sha          String
  prNumber     Int?
  repoFullName String
  confidence   Int
  outcome      String?  // e.g. "SUCCESS", "FAILURE", "REVERTED", "PENDING"
  source       String?  // "git-note" | "comment"
  commenter    String?  // GitHub login of the person who replied via comment
  userId       String
  user         User     @relation(fields: [userId], references: [id])
  timestamp    DateTime @default(now())
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([sha, repoFullName])
  @@unique([repoFullName, prNumber, userId])
}

/// Tracks GitHub App installations (one row per installation, updated on
/// installation webhooks). Used to know which repos an installation covers.
model Installation {
  id           Int      @id  // GitHub installation ID
  appId        Int
  accountLogin String
  repos        String[] // array of repo full_names covered by this installation
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

/// Tracks the bot's confidence-prompt comment on each PR so we can edit it
/// in-place rather than spamming new comments.
model ConfidencePrompt {
  id           String   @id @default(uuid())
  repoFullName String
  prNumber     Int
  commentId    BigInt   // GitHub comment ID of the bot's prompt comment
  answered     Boolean  @default(false)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([repoFullName, prNumber])
}

/// Per-repo PRoof settings. One row per repo that has had settings touched.
/// Repos with no row are implicitly mandatory: false (the default).
model RepoSettings {
  repoFullName String   @id
  mandatory    Boolean  @default(false)
  updatedBy    String?
  updatedAt    DateTime @updatedAt
  createdAt    DateTime @default(now())
}
